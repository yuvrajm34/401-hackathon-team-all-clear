# Optional — only needed for AI resume parsing and tailoring suggestions.
# Requires Ollama running locally (https://ollama.com) with the model pulled:
#   ollama pull gemma3
# Without Ollama running, both features fall back automatically:
# resume upload uses the built-in text-based parser, and the AI suggestions
# button in an application's Keyword match panel shows an error instead.
#
# gemma3 (4.3B) is the default for speed — local generation speed scales
# with model size, and it measured ~3x faster than llama3.1:8b on the same
# hardware with comparable resume-parsing quality. If you hit worse results
# on an unusual resume format, try OLLAMA_MODEL=llama3.1:8b instead
# (slower, larger model — `ollama pull llama3.1:8b` first).

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
